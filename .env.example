# Copy this file to .env.local and fill only the values needed locally.
# Never commit .env.local or real credentials.
# Production values belong in Vercel encrypted environment variables.
GITHUB_TOKEN=
DATABASE_URL=
DIRECT_DATABASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_PROXY_URL=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local Inngest Dev Server only. Omit this variable in Vercel Production/Preview.
INNGEST_DEV=1
