{
  "name": "issuelens",
  "version": "0.1.0",
  "private": true,
  "description": "将公开 GitHub Issues 转化为可追溯产品洞察的 AI 分析工具。",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:smoke": "tsx scripts/db-smoke.ts",
    "github:smoke": "tsx scripts/github-smoke.ts",
    "github:import": "tsx scripts/github-import.ts",
    "ai:slice": "tsx scripts/ai-vertical-slice.ts",
    "ai:verify": "tsx scripts/ai-verify.ts",
    "workflow:request": "tsx scripts/workflow-request.ts",
    "workflow:verify": "tsx scripts/workflow-verify.ts",
    "workflow:resume": "tsx scripts/workflow-resume.ts",
    "cluster:verify": "tsx scripts/cluster-verify.ts",
    "workflow:reconcile": "tsx scripts/workflow-reconcile.ts",
    "metrics:run": "node scripts/report-run-metrics.mjs",
    "security:scan": "node scripts/secret-scan.mjs",
    "release:check": "pnpm security:scan && pnpm lint && pnpm typecheck && pnpm test && pnpm db:check && pnpm build",
    "inngest:dev": "inngest-cli dev --no-discovery -u http://localhost:3000/api/inngest",
    "test:db": "vitest run src/db",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:check && pnpm build"
  },
  "engines": {
    "node": ">=20.9 <25",
    "pnpm": "11.19.0"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "inngest": "4.18.1",
    "next": "16.3.1",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "undici": "7.16.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.5",
    "@inngest/test": "1.0.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "inngest-cli": "1.43.0",
    "tailwindcss": "^4",
    "tsx": "4.23.12",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.19.0"
}
